    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swiper": "^11.1.1"
  },
  "devDependencies": {
    "@inquirer/select": "^5.2.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^25.0.1",
    "tiktok-minis-cli": "0.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.2.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "body-parser": "1.20.4",
